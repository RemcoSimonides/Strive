default_platform(:ios)

MAIN_APP_ID = "com.strive.journal"
SHARE_EXT_ID = "com.strive.journal.share"
TEAM_ID = "2Z8SN3C4MM"
KEYCHAIN_NAME = "fastlane_keychain"
KEYCHAIN_PASSWORD = "fastlane_password"

platform :ios do
  desc "Fetch or create signing certificates and provisioning profiles via Match"
  lane :certificates do
    if is_ci
      create_keychain(
        name: KEYCHAIN_NAME,
        password: KEYCHAIN_PASSWORD,
        default_keychain: true,
        unlock: true,
        timeout: 3600,
      )
    end

    match(
      type: "appstore",
      app_identifier: [MAIN_APP_ID, SHARE_EXT_ID],
      readonly: is_ci,
      keychain_name: is_ci ? KEYCHAIN_NAME : nil,
      keychain_password: is_ci ? KEYCHAIN_PASSWORD : nil,
    )
  end

  desc "Build a signed IPA"
  lane :build do
    certificates

    # Switch both targets to manual signing for CI builds
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      team_id: TEAM_ID,
      bundle_identifier: MAIN_APP_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: ENV["sigh_#{MAIN_APP_ID}_appstore_profile-name"],
      targets: ["App"],
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      team_id: TEAM_ID,
      bundle_identifier: SHARE_EXT_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: ENV["sigh_#{SHARE_EXT_ID}_appstore_profile-name"],
      targets: ["share"],
    )

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      output_directory: "./build",
      output_name: "StriveJournal.ipa",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          MAIN_APP_ID => ENV["sigh_#{MAIN_APP_ID}_appstore_profile-name"],
          SHARE_EXT_ID => ENV["sigh_#{SHARE_EXT_ID}_appstore_profile-name"],
        }
      }
    )
  end

  desc "Create an App Store Connect API key from env"
  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
    )
  end

  desc "Bump build number (and marketing version if already released) based on App Store Connect state"
  private_lane :bump_versions do |options|
    api_key = options[:api_key]

    live_build = begin
      app_store_build_number(api_key: api_key, live: true, app_identifier: MAIN_APP_ID)
    rescue StandardError
      0
    end
    live_version = lane_context[SharedValues::LATEST_VERSION].to_s

    tf_build = begin
      latest_testflight_build_number(api_key: api_key, app_identifier: MAIN_APP_ID)
    rescue StandardError
      0
    end

    new_build = [live_build.to_i, tf_build.to_i, get_build_number.to_i].max + 1
    increment_build_number(build_number: new_build)

    # A marketing version that has already been released can't be submitted
    # again, so move one patch beyond the live version when needed.
    current_version = get_version_number(xcodeproj: "App.xcodeproj", target: "App")
    if !live_version.empty? && Gem::Version.new(current_version) <= Gem::Version.new(live_version)
      parts = live_version.split(".").map(&:to_i)
      parts << 0 while parts.length < 3
      parts[2] += 1
      increment_version_number(version_number: parts.join("."))
    end
  end

  desc "Deploy to TestFlight"
  lane :deploy_testflight do
    api_key = asc_api_key
    bump_versions(api_key: api_key)
    build

    upload_to_testflight(
      api_key: api_key,
      ipa: "./build/StriveJournal.ipa",
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Deploy to App Store production and submit for review"
  lane :deploy_production do
    api_key = asc_api_key
    bump_versions(api_key: api_key)
    build

    upload_to_app_store(
      api_key: api_key,
      ipa: "./build/StriveJournal.ipa",
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      force: true,
      submit_for_review: true,
      automatic_release: true,
      submission_information: {
        add_id_info_uses_idfa: false,
      },
    )
  end
end
